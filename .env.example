# =============================================================================
# HDX Sensitive Data Detection (SDD) Pipeline Configuration
# =============================================================================

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Model Configuration
PII_DETECT_MODEL=pii-detect-v1
PII_REFLECT_MODEL=pii-reflect-v1
NON_PII_DETECT_MODEL=non-pii-detect-v1
README_SCAN_MODEL=readme-scan-v1

# Processing Control
WORKER_ENABLED=true
RERUN=false

# Processing Steps (enable/disable individual steps)
PERSONAL_DATA_DETECTION=true
PERSONAL_DATA_REFLECTION=true
NON_PERSONAL_DATA_DETECTION=true
README_SCAN=true
CKAN_UPDATE=true

# Redis Configuration
REDIS_STREAM_STREAM_NAME=hdx_event_stream
REDIS_STREAM_GROUP_NAME=hdx_sdd_group
REDIS_STREAM_CONSUMER_NAME=hdx_sdd_consumer_1
REDIS_STREAM_HOST=redis
REDIS_STREAM_PORT=6379
REDIS_STREAM_DB=7

# HDX/CKAN Configuration
HDX_URL=https://data.humdata.org
HDX_KEY=your_hdx_api_key_here

# Directory Configuration
OUTPUT_DIR=/tmp/reports
DOWNLOAD_DIR=/tmp/download

# Slack Integration (optional)
HDX_SDD_SLACK_CHANNEL=topic-sensitive-data-alerts
# HDX_SDD_SLACK_ACCESS_TOKEN=xoxb-your-slack-bot-token-here

# Optional: Additional Configuration
# LOG_LEVEL=INFO
